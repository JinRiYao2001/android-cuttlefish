#!/usr/bin/make -f

# Start build by executing:
# $ debuild --prepend-path /usr/local/bin --no-tgz-check -us -uc

# Uncomment this line out to make installation process more chatty.
# Keep it on until we know there's no outstanding problems with installation.
# export DH_VERBOSE=1

# There's a bug here
export DEB_BUILD_MAINT_OPTIONS=hardening=-format

include /usr/share/dpkg/buildflags.mk


%:
	dh $@ --with=config-package

override_dh_auto_build:
  # Enable git and curl verbose output for debugging git clone
  export GIT_TRACE=1
  export GIT_CURL_VERBOSE=1

  # First, install init services
  dh_installinit --name=cuttlefish-host-resources
  dh_installinit

  # Now perform the bazel build
  cd cvd && bazel build --linkopt="-Wl,--build-id=sha1" 'cuttlefish/package:cvd' \
    --spawn_strategy=local --workspace_status_command=../stamp_helper.sh \
    --build_tag_filters=-clang-tidy --fetch_timeout=600 --execution_timeout=3600 \
    --verbose_failures --experimental_repo_debug

  # Run the standard dh_auto_build process
  dh_auto_build